dashboard/data/pilot-state.json
dashboard/data/outreach-log.json
dashboard/data/activity-log.json

# ── Generated pipeline outputs ────────────────────────────────────────────────
# Draft company configs and outreach scripts produced by the generation pipeline.
# Not source code. Not public. Regenerated on demand.
generated/configs/*.json
generated/outreach/*.json

# ── Lead enrichment data ──────────────────────────────────────────────────────
# Contains real company phone numbers, WhatsApp numbers, and contact research.
leads/
blitz_batch_input.csv
needs-manual-review/

