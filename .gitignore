# NeST tender data and pipeline working files. Large and frequently regenerated.
data/ingestion/raw/
data/ingestion/normalized/
data/ingestion/qualified/
data/ingestion/rejected/
data/ingestion/logs/

# ── Test output ───────────────────────────────────────────────────────────────
test-results.json

# ── Environment and secrets ───────────────────────────────────────────────────
.env
.env.*
*.local
*.local.*

